# Cal.com inline embed link, format "<username>/<event-slug>".
# Public: exposed to the browser.
NEXT_PUBLIC_CAL_URL=rohit/discovery-call

# Resend API key for /api/lead delivery.
# Server-only.
RESEND_API_KEY=

# Inbox the lead form forwards to.
# Server-only.
LEAD_TO_EMAIL=

# Optional. Defaults to "AI Buildspace <onboarding@resend.dev>".
# Override once a custom domain is verified in Resend.
LEAD_FROM_EMAIL=

# Keystatic CMS storage mode: "local" (default) or "github" (requires GitHub App, see #1549).
KEYSTATIC_STORAGE=local

# Keystatic GitHub App credentials. Only needed when KEYSTATIC_STORAGE=github.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Keystatic GitHub App slug. Only needed when KEYSTATIC_STORAGE=github.
# Public: exposed to the browser.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# PostHog analytics. Optional: analytics no-ops if key is absent.
# Public: exposed to the browser. Host is NOT configured here: events are
# proxied through /ingest (see next.config.ts rewrites) to dodge blockers.
NEXT_PUBLIC_POSTHOG_KEY=

# Google Search Console ownership verification token. Optional.
# Public: exposed to the browser.
NEXT_PUBLIC_GSC_VERIFICATION=
